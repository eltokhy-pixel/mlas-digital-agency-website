<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Foloblox - Creative Director</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #FF5722;
            --secondary: #FF7043;
            --dark: #0D0D0D;
            --dark-light: #1A1A1A;
            --text: #FFFFFF;
            --text-light: #CCCCCC;
            --accent: #FFB74D;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--dark);
            color: var(--text);
            overflow-x: hidden;
        }

        /* Navbar */
        .navbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: transparent;
            backdrop-filter: blur(10px);
            padding: 1.5rem 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .nav-container {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text);
            letter-spacing: 1px;
        }

        .nav-menu {
            display: flex;
            list-style: none;
            gap: 2.5rem;
            align-items: center;
        }

        .nav-menu a {
            color: var(--text-light);
            text-decoration: none;
            font-size: 0.9rem;
            transition: 0.3s ease;
            position: relative;
        }

        .nav-menu a:hover {
            color: var(--primary);
        }

        .btn-contact {
            background: var(--text) !important;
            color: var(--primary) !important;
            padding: 0.5rem 1.2rem;
            border-radius: 30px;
            font-weight: 600;
            transition: 0.3s ease;
        }

        .btn-contact:hover {
            background: var(--accent) !important;
            color: var(--dark) !important;
        }

        /* Hero Section */
        .hero {
            position: relative;
            background: linear-gradient(135deg, #FF5722 0%, #FF7043 50%, #8B4513 100%);
            min-height: 100vh;
            padding: 4rem 2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 50%;
            height: 100%;
            background: radial-gradient(circle at top right, rgba(0,0,0,0.2), transparent);
            pointer-events: none;
        }

        .hero-container {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 3rem;
            align-items: center;
            position: relative;
            z-index: 1;
            width: 100%;
        }

        .hero-content h2 {
            font-size: 1.1rem;
            font-weight: 400;
            margin-bottom: 0.5rem;
            opacity: 0.9;
        }

        .hero-content h1 {
            font-size: 4.5rem;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 3rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .services-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .service-item {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }

        .service-number {
            font-size: 0.85rem;
            opacity: 0.7;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .service-name {
            font-size: 0.95rem;
            font-weight: 500;
        }

        .hero-image {
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .hero-image img {
            width: 100%;
            max-width: 350px;
            border-radius: 20px;
            object-fit: cover;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
        }

        .hero-right {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .hero-right h3 {
            font-size: 1.8rem;
            font-weight: 700;
            line-height: 1.3;
        }

        .hero-right p {
            font-size: 0.95rem;
            opacity: 0.9;
            line-height: 1.6;
        }

        /* Trusted Brands */
        .trusted-brands {
            position: relative;
            z-index: 1;
            margin-top: 4rem;
            padding-top: 2rem;
            border-top: 1px solid rgba(255,255,255,0.2);
        }

        .trusted-brands p {
            font-size: 0.9rem;
            opacity: 0.8;
            margin-bottom: 1.5rem;
        }

        .brands-list {
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .brand-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
        }

        .brand-item i {
            font-size: 0.6rem;
        }

        /* Behind Designs Section */
        .behind-designs {
            background: var(--dark);
            padding: 6rem 2rem;
        }

        .behind-container {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .behind-left h2 {
            font-size: 0.9rem;
            color: var(--primary);
            font-weight: 600;
            letter-spacing: 1px;
            margin-bottom: 1rem;
        }

        .behind-left h3 {
            font-size: 3rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 1.5rem;
        }

        .behind-left p {
            font-size: 1rem;
            color: var(--text-light);
            margin-bottom: 1rem;
            line-height: 1.6;
        }

        .subtitle {
            font-size: 1.2rem !important;
            color: var(--text) !important;
            font-weight: 600;
            margin: 2rem 0 !important;
        }

        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }

        .portfolio-item {
            aspect-ratio: 1;
            border-radius: 20px;
            overflow: hidden;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .portfolio-item:hover {
            transform: scale(1.05);
        }

        .portfolio-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Buttons */
        .btn {
            padding: 1rem 2rem;
            border: none;
            border-radius: 50px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-primary {
            background: var(--primary);
            color: var(--text);
            box-shadow: 0 10px 30px rgba(255, 87, 34, 0.3);
        }

        .btn-primary:hover {
            background: var(--secondary);
            transform: translateY(-2px);
            box-shadow: 0 15px 40px rgba(255, 87, 34, 0.4);
        }

        /* Projects Section */
        .projects {
            background: var(--dark);
            padding: 6rem 2rem;
        }

        .projects-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .projects h2 {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 3rem;
            text-align: center;
        }

        .project-showcase {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
        }

        .project-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            overflow: hidden;
            transition: 0.3s ease;
        }

        .project-card:hover {
            transform: translateY(-10px);
            border-color: var(--primary);
            box-shadow: 0 20px 50px rgba(255, 87, 34, 0.2);
        }

        .project-image {
            width: 100%;
            height: 250px;
            overflow: hidden;
        }

        .project-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .project-card h3 {
            font-size: 1.3rem;
            margin: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .project-card p {
            color: var(--text-light);
            margin: 0 1.5rem 1.5rem;
            font-size: 0.9rem;
        }

        .project-link {
            display: inline-block;
            margin: 0 1.5rem 1.5rem;
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s ease;
        }

        .project-link:hover {
            color: var(--secondary);
            transform: translateX(5px);
        }

        /* Contact Section */
        .contact {
            background: linear-gradient(135deg, rgba(255, 87, 34, 0.1), rgba(255, 112, 67, 0.05));
            padding: 6rem 2rem;
        }

        .contact-container {
            max-width: 600px;
            margin: 0 auto;
            text-align: center;
        }

        .contact h2 {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
        }

        .contact p {
            color: var(--text-light);
            margin-bottom: 2rem;
            font-size: 1rem;
        }

        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 1rem;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: var(--text);
            border-radius: 10px;
            font-family: inherit;
            font-size: 0.95rem;
            transition: 0.3s ease;
        }

        .form-group input::placeholder,
        .form-group textarea::placeholder {
            color: var(--text-light);
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--primary);
            background: rgba(255, 87, 34, 0.1);
        }

        .form-group textarea {
            min-height: 120px;
            resize: vertical;
        }

        /* Footer */
        .footer {
            background: rgba(0, 0, 0, 0.5);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding: 2rem;
        }

        .footer-container {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .footer p {
            color: var(--text-light);
            font-size: 0.9rem;
        }

        .social-links {
            display: flex;
            gap: 1rem;
        }

        .social-links a {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 87, 34, 0.2);
            border: 1px solid rgba(255, 87, 34, 0.5);
            border-radius: 50%;
            color: var(--primary);
            text-decoration: none;
            transition: 0.3s ease;
        }

        .social-links a:hover {
            background: var(--primary);
            color: var(--text);
        }

        /* WhatsApp Float */
        .whatsapp-float {
            position: fixed;
            bottom: 2rem;
            left: 2rem;
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #25D366, #128C7E);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            z-index: 999;
            box-shadow: 0 10px 30px rgba(37, 211, 102, 0.4);
            transition: 0.3s ease;
            text-decoration: none;
        }

        .whatsapp-float:hover {
            transform: scale(1.1);
            box-shadow: 0 15px 40px rgba(37, 211, 102, 0.6);
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .hero-container {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .behind-container {
                grid-template-columns: 1fr;
            }

            .hero-content h1 {
                font-size: 3rem;
            }

            .behind-left h3 {
                font-size: 2rem;
            }
        }

        @media (max-width: 768px) {
            .nav-menu {
                gap: 1rem;
                font-size: 0.8rem;
            }

            .hero {
                padding: 2rem 1rem;
                min-height: auto;
            }

            .hero-content h1 {
                font-size: 2rem;
            }

            .services-list {
                grid-template-columns: 1fr;
            }

            .hero-image img {
                max-width: 250px;
            }

            .behind-left h3 {
                font-size: 1.5rem;
            }

            .portfolio-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .project-showcase {
                grid-template-columns: 1fr;
            }

            .footer-container {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }

            .whatsapp-float {
                bottom: 1rem;
                left: 1rem;
                width: 50px;
                height: 50px;
                font-size: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">Foloblox</div>
            <ul class="nav-menu">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#contact" class="btn-contact">Get in touch</a></li>
            </ul>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <div class="hero-container">
            <div class="hero-content">
                <h2>Hey, I'm a</h2>
                <h1>Creative<br>Director</h1>
                
                <div class="services-list">
                    <div class="service-item">
                        <span class="service-number">01</span>
                        <span class="service-name">Brand Strategy</span>
                    </div>
                    <div class="service-item">
                        <span class="service-number">02</span>
                        <span class="service-name">Brand Identity Design</span>
                    </div>
                    <div class="service-item">
                        <span class="service-number">03</span>
                        <span class="service-name">Packaging Design</span>
                    </div>
                    <div class="service-item">
                        <span class="service-number">04</span>
                        <span class="service-name">Creative Direction</span>
                    </div>
                </div>
            </div>

            <div class="hero-image">
                <img src="https://via.placeholder.com/400x500/ff4500/ff6347?text=Profile+Image" alt="Creative Director">
            </div>

            <div class="hero-right">
                <h3>Great design should<br>feel invisible.</h3>
                <p>From logo to language, I build brands that connect and convert.</p>
            </div>
        </div>

        <!-- Trusted by Brands -->
        <div class="trusted-brands">
            <p>Trusted by Brands I've helped Shape</p>
            <div class="brands-list">
                <div class="brand-item">
                    <i class="fas fa-circle"></i>
                    <span>Supa Blox</span>
                </div>
                <div class="brand-item">
                    <i class="fas fa-bookmark"></i>
                    <span>Hype Blox</span>
                </div>
                <div class="brand-item">
                    <i class="fas fa-square"></i>
                    <span>Frame Blox</span>
                </div>
                <div class="brand-item">
                    <i class="fas fa-circle"></i>
                    <span>Ultra Blox</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Behind the Designs Section -->
    <section class="behind-designs" id="about">
        <div class="behind-container">
            <div class="behind-left">
                <h2>Behind the Designs</h2>
                <h3>Shaping Experiences That<br>Make Life Simpler</h3>
                <p>I'm a product designer focused on building clean, intuitive interfaces that solve real-world problems.</p>
                <p class="subtitle">Let's Build Something<br>Meaningful together</p>
                <button class="btn btn-primary">Get in touch <i class="fas fa-arrow-right"></i></button>
            </div>

            <div class="behind-right">
                <div class="portfolio-grid">
                    <div class="portfolio-item">
                        <img src="https://via.placeholder.com/200x250/f5f5f5/999?text=Design+1" alt="Portfolio 1">
                    </div>
                    <div class="portfolio-item">
                        <img src="https://via.placeholder.com/200x250/f5f5f5/999?text=Design+2" alt="Portfolio 2">
                    </div>
                    <div class="portfolio-item">
                        <img src="https://via.placeholder.com/200x250/f5f5f5/999?text=Design+3" alt="Portfolio 3">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section class="projects" id="projects">
        <div class="projects-container">
            <h2>Featured Projects</h2>
            
            <div class="project-showcase">
                <div class="project-card">
                    <div class="project-image">
                        <img src="https://via.placeholder.com/400x300/ff4500/ff6347?text=Project+1" alt="Project 1">
                    </div>
                    <h3>Luxury Brand Identity</h3>
                    <p>A complete visual identity system for a premium lifestyle brand</p>
                    <a href="#" class="project-link">View Project →</a>
                </div>

                <div class="project-card">
                    <div class="project-image">
                        <img src="https://via.placeholder.com/400x300/ff4500/ff6347?text=Project+2" alt="Project 2">
                    </div>
                    <h3>E-Commerce Platform</h3>
                    <p>Modern UI/UX design for an innovative online marketplace</p>
                    <a href="#" class="project-link">View Project →</a>
                </div>

                <div class="project-card">
                    <div class="project-image">
                        <img src="https://via.placeholder.com/400x300/ff4500/ff6347?text=Project+3" alt="Project 3">
                    </div>
                    <h3>Digital Campaign</h3>
                    <p>Integrated marketing campaign with stunning visual storytelling</p>
                    <a href="#" class="project-link">View Project →</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact" id="contact">
        <div class="contact-container">
            <h2>Let's Create Something Amazing</h2>
            <p>Ready to transform your brand? Get in touch with me today.</p>
            
            <form class="contact-form">
                <div class="form-group">
                    <input type="text" placeholder="Your Name" required>
                </div>
                <div class="form-group">
                    <input type="email" placeholder="Your Email" required>
                </div>
                <div class="form-group">
                    <textarea placeholder="Tell me about your project..." required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Send Message</button>
            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-container">
            <p>&copy; 2026 MLAS Creative Director. All rights reserved.</p>
            <div class="social-links">
                <a href="#" title="Instagram"><i class="fab fa-instagram"></i></a>
                <a href="#" title="Twitter"><i class="fab fa-twitter"></i></a>
                <a href="#" title="LinkedIn"><i class="fab fa-linkedin"></i></a>
                <a href="#" title="Dribbble"><i class="fab fa-dribbble"></i></a>
            </div>
        </div>
    </footer>

    <!-- Floating WhatsApp Button -->
    <a href="https://wa.me/201000000000" class="whatsapp-float" target="_blank">
        <i class="fab fa-whatsapp"></i>
    </a>

    <script>
        // Smooth scroll for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });

        // Form submission
        document.querySelector('.contact-form')?.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const name = this.querySelector('input[type="text"]').value;
            const email = this.querySelector('input[type="email"]').value;
            const message = this.querySelector('textarea').value;
            
            // Create WhatsApp message
            const waMessage = `Hello,\n\nName: ${name}\nEmail: ${email}\n\nMessage: ${message}`;
            const waLink = `https://wa.me/201000000000?text=${encodeURIComponent(waMessage)}`;
            
            window.open(waLink, '_blank');
            this.reset();
        });

        // Scroll animation for elements
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -100px 0px'
        };

        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animation = 'slideIn 0.6s ease-out forwards';
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.project-card, .portfolio-item').forEach(el => {
            observer.observe(el);
        });

        console.log('✨ Creative Director Portfolio Loaded!');
    </script>
</body>
</html>
